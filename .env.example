# Bitbucket HTTP Access Token (ATATT3x... formatı)
# Oluşturma: Bitbucket > Repository/Project/Workspace Settings > Access tokens
# Gerekli izinler: Pull requests (Read, Write), Repositories (Read)
BITBUCKET_TOKEN=ATATT3x...

# Hangi repo takip edilecek
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO_SLUG=your-repo-name
